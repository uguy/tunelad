        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tunelad_live_events_delivered_total{application=\"$application\"}[$__rate_interval])) / sum(rate(tunelad_live_events_published_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "delivered / published",
          "refId": "A",
          "editorMode": "code",
