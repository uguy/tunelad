      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\",uri=~\"/api/me/favourites|/api/tracks/\\\\{id\\\\}/favourite\"}[$__rate_interval])))",
