          "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\",uri=~\"/api/me/favourites|/api/tracks/\\\\{id\\\\}/favourite\"}[$__rate_interval])) + sum(rate(http_server_requests_seconds_count{application=\"$application\",uri=~\"/api/playlists.*\"}[$__rate_interval]))",
