    {
      "id": 6,
      "type": "timeseries",
      "title": "Open live connections",
      "description": "Drops to zero when no tab is open; a sawtooth means clients reconnecting.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
