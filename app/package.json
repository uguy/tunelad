{
	"name": "tunelad",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && mkdir -p ../target/classes/static/ && cp -r ./build/* ../target/classes/static/",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"lint": "prettier  --plugin=prettier-plugin-svelte --check . && eslint .",
		"format": "prettier --plugin=prettier-plugin-svelte --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vite-pwa/sveltekit": "^2.0.2",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.0.2",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"magicast": "^0.5.5",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-time": "^2.3.2",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"abcjs": "^6.7.3"
	}
}
