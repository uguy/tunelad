{
	"name": "tunelad",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && mkdir -p ../target/classes/static/ && cp -r ./build/* ../target/classes/static/",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"lint": "prettier  --plugin=prettier-plugin-svelte --check . && eslint .",
		"format": "prettier --plugin=prettier-plugin-svelte --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^25",
		"@vite-pwa/sveltekit": "^2.0.2",
		"@vitest/browser-playwright": "^5.1.0",
		"autoprefixer": "^10.6.1",
		"cssnano": "^7.0.6",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.0.2",
		"eslint-plugin-storybook": "^10.1.7",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"magicast": "^0.5.5",
		"postcss": "^8.5.30",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-time": "^2.0.2",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	}
}
